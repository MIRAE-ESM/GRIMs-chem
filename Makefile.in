ISOROPIA = ISOROPIA/isoropiaIIcode.o

OBJS = start_chem.o integrate_chem.o end_chem.o

CP = @CP@
CC = @CC@
F77 = @F77_FCST@
FORT_FLAGS = @FORT_FLAGS@
INCLUDE_DIR = @INCLUDE_DIR@
INSTALLDLIB = @INSTALLDLIB@

chemistry.a : ${HEADERS} ${KPPS} ${UTILS} ${CORES} ${ISOROPIA} ${OBJS}
	${AR} -r $@ ${HEADERS} ${KPPS} ${UTILS} ${CORES} ${ISOROPIA} ${OBJS}
	${CP} $@ ${INSTALLDLIB}

clean :
	rm -f *.o *.a ${HEADERDIR}/*.o ${KPPDIR}/*.o ${UTILDIR}/*.o ${COREDIR}/*.o ISOROPIA/*.o

.SUFFIXES : .o .F .F90 .c

.F.o :
	${F77} ${FORT_FLAGS} ${INCLUDE_DIR} -c $< -o $@

.F90.o :
	${F77} ${FORT_FLAGS} ${INCLUDE_DIR} -c $< -o $@

.c.o :
	${CC} -c $< -o $@
